# Copy to .env and fill in values: cp .env.example .env
# DB_HOST is overridden to "db" by docker-compose for the web container.

# Database
NYCHAREALTALK_DB_NAME=nycharealtalk
NYCHAREALTALK_DB_USER=nycharealtalk
NYCHAREALTALK_DB_PASSWORD=nycharealtalk
NYCHAREALTALK_DB_HOST=localhost
NYCHAREALTALK_DB_PORT=5432
NYCHAREALTALK_MEMCACHE_LOCATION=memcached:11211

# Django
NYCHAREALTALK_SECRET_KEY=change-me-in-production

# reCAPTCHA — leave blank to skip validation in development
NYCHAREALTALK_RECAPTCHA_PRIVATE_KEY=
NYCHAREALTALK_RECAPTCHA_PUBLIC_KEY=

# Organizing
NYCHAREALTALK_ORGANIZE_PARTICIPANT_SALT=change-me

# Activity stream default actor
NYCHAREALTALK_ACTSTREAM_DEFAULT_ACTOR_PK=1

# Mail reader — only needed in production
NYCHAREALTALK_MAILREADER_HOST=
NYCHAREALTALK_MAILREADER_HOST_USER=
NYCHAREALTALK_MAILREADER_HOST_PASSWORD=
NYCHAREALTALK_MAILREADER_HOST_PASSWORD=

# Living Lots NYC sync — only needed when syncing remote lots
NYCHAREALTALK_LLNYC_API_KEY=

NYCHAREALTALK_DOMAIN=nycharealtalk.org
NYCHAREALTALK_TILES_DOMAIN=tiles.nycharealtalk.org
NYCHAREALTALK_ALLOWED_HOSTS=nycharealtalk.org,www.nycharealtalk.org

NYCHAREALTALK_EMAIL_HOST=localhost
NYCHAREALTALK_EMAIL_USER=nycommonsmail
NYCHAREALTALK_EMAIL_PASSWORD=nycommons
NYCHAREALTALK_DEFAULT_FROM_EMAIL=admin@nycommons.org
NYCHAREALTALK_SERVER_EMAIL=admin@nycommons.org
